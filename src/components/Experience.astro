---
import Window from './Window.astro';
import SectionHeader from './SectionHeader.astro';
import { languages, useTranslations, type Lang } from '../i18n';
import { experience, education, type TimelineItem } from '../data/experience';
import { skillLabels } from '../data/skills';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const fmt = new Intl.DateTimeFormat(languages[lang].locale, { month: 'short', year: 'numeric', timeZone: 'UTC' });
const formatMonth = (ym: string) => fmt.format(new Date(`${ym}-01T00:00:00Z`));
const range = (item: TimelineItem) =>
  `${formatMonth(item.start)} – ${item.end ? formatMonth(item.end) : t.experience.present}`;
const tagLabel = (tag: string) => (lang === 'es' ? tag : (skillLabels[tag]?.[lang] ?? tag));

const blocks = [
  { title: t.term.files.experience, cmd: 'git log --graph', items: experience },
  { title: lang === 'es' ? 'educacion.log' : lang === 'fr' ? 'formation.log' : 'education.log', cmd: 'cat', items: education },
];
---

<section id="experiencia" class="section">
  <div class="container-page">
    <SectionHeader
      index="02"
      file={t.term.files.experience}
      title={t.experience.title}
      subtitle={t.experience.subtitle}
      agent="data"
      builtBy={t.term.builtBy}
    />

    <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-6 items-start">
      {
        blocks.map((block, bi) => (
          <Window title={block.title} data-reveal bodyClass="p-5 sm:p-6 text-sm">
            <p class="text-muted mb-5">
              $ {block.cmd} {bi === 0 ? '' : block.title}
            </p>
            <ol class="relative">
              {block.items.map((item, i) => (
                <li class="relative ps-7 pb-7 last:pb-0">
                  {i < block.items.length - 1 && (
                    <span class="absolute left-[5px] top-4 bottom-0 w-px bg-line" aria-hidden="true" />
                  )}
                  <span
                    class:list={[
                      'absolute left-0 top-1.5 w-[11px] h-[11px] rounded-full border-2',
                      item.end ? 'border-muted bg-ink' : 'border-term-green bg-term-green shadow-[0_0_10px] shadow-term-green',
                    ]}
                    aria-hidden="true"
                  />
                  <p class="text-xs">
                    {!item.end && bi === 0 && (
                      <span class="text-term-amber me-1">
                        (HEAD → <span class="text-term-green">{t.experience.present.toLowerCase()}</span>)
                      </span>
                    )}
                    <time datetime={item.start} class="text-muted">
                      {range(item)}
                    </time>
                    <span class="text-muted"> · {item.type[lang]}</span>
                  </p>
                  <h3 class="mt-1 text-base sm:text-lg font-bold text-white">{item.role[lang]}</h3>
                  <p class="text-term-cyan text-[13px]">@ {item.org}</p>
                  {item.points[lang].length > 0 && (
                    <ul class="mt-3 space-y-1.5 font-sans text-[15px] text-fg">
                      {item.points[lang].map((p) => (
                        <li class="flex gap-2">
                          <span class="font-mono text-term-green" aria-hidden="true">+</span>
                          <span>{p}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {item.tags && (
                    <ul class="flex flex-wrap gap-2 mt-4" aria-label="Tags">
                      {item.tags.map((tag) => (
                        <li class="tag">#{tagLabel(tag)}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </Window>
        ))
      }
    </div>
  </div>
</section>
