---
import Window from './Window.astro';
import { useTranslations, type Lang } from '../i18n';
import { profile } from '../data/profile';
import { agents, type AgentKey } from '../data/agents';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prompt = '<span class="prompt-user">luis@portafolio</span><span class="text-muted">:</span><span class="prompt-path">~</span><span class="text-muted">$</span>';
const agentRows = (Object.keys(agents) as AgentKey[]).map((k) => ({ ...agents[k], key: k, text: t.term.agents[k] }));
---

<section id="inicio" class="relative min-h-[100svh] flex items-center pt-20 pb-12">
  <div class="container-page w-full grid lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] gap-6 items-start">
    <Window title="~/portafolio — zsh" meta="80×24" build="hero" id="hero-terminal" bodyClass="p-5 sm:p-7 text-sm sm:text-base">
      <p><Fragment set:html={prompt} /> <span data-type>whoami</span></p>
      <h1 class="mt-2 mb-6 text-3xl sm:text-5xl lg:text-[3.4rem] font-extrabold leading-[1.08] tracking-tight text-white">
        <span id="typed-name">{profile.fullName}</span><span class="caret-block" aria-hidden="true"></span>
      </h1>

      <p><Fragment set:html={prompt} /> <span data-type>cat {t.term.roleFile}</span></p>
      <p data-build="role" class="mt-1.5 text-lg sm:text-2xl font-semibold text-term-green">{t.hero.title}</p>
      <p data-build="desc" class="mt-3 font-sans text-muted leading-relaxed max-w-2xl">
        <span class="font-mono text-term-amber"># </span>{t.hero.description}
      </p>

      <p class="mt-7"><Fragment set:html={prompt} /> <span data-type>ls ./{t.term.actionsDir}</span></p>
      <div data-build="actions" class="mt-2.5 flex flex-col sm:flex-row flex-wrap gap-3">
        <a href="#proyectos" class="btn-term-primary">{t.term.cmdProjects}</a>
        <a href="#contacto" class="btn-term">{t.term.cmdContact}</a>
      </div>
    </Window>

    <Window title={t.term.agentsTitle} meta="● live" build="agents" id="agents-panel" bodyClass="p-4 sm:p-5 text-[13px]">
      <ul class="space-y-2">
        {
          agentRows.map((a) => (
            <li class="flex items-baseline gap-2" data-agent-row={a.key}>
              <span class="text-term-green" data-row-check aria-hidden="true">✓</span>
              <span class="font-bold shrink-0" style={`color:${a.color}`}>{a.name}</span>
              <span class="text-muted truncate">{a.text}</span>
            </li>
          ))
        }
      </ul>
      <div class="border-t border-dashed border-line my-4"></div>
      <p class="flex items-center gap-2">
        <span class="text-muted">{t.term.status}:</span>
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-term-green opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-term-green"></span>
        </span>
        <span class="text-fg">{t.hero.available}</span>
      </p>
    </Window>
  </div>
</section>
