---
import Icon from './Icon.astro';
import Window from './Window.astro';
import SectionHeader from './SectionHeader.astro';
import { languages, useTranslations, type Lang } from '../i18n';
import { certifications } from '../data/certifications';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const fmt = new Intl.DateTimeFormat(languages[lang].locale, { dateStyle: 'medium', timeZone: 'UTC' });
---

<section id="certificaciones" class="section">
  <div class="container-page">
    <SectionHeader
      index="05"
      file={t.term.files.certifications}
      title={t.certifications.title}
      subtitle={t.certifications.subtitle}
      agent="data"
      builtBy={t.term.builtBy}
    />

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        certifications.map((c, i) => (
          <li data-reveal>
            <Window title={`cert_${String(i + 1).padStart(2, '0')}.yml`} class="h-full" bodyClass="p-5 flex gap-4 items-start text-[13px]">
              <img
                src={c.logo}
                alt=""
                width="72"
                height="72"
                loading="lazy"
                decoding="async"
                class="w-[72px] h-[72px] object-contain shrink-0"
              />
              <dl class="min-w-0 leading-6">
                <div class="flex gap-1.5">
                  <dt class="text-term-pink">title:</dt>
                  <dd class="text-white font-bold">{c.title}</dd>
                </div>
                <div class="flex gap-1.5">
                  <dt class="text-term-pink">issuer:</dt>
                  <dd>{c.issuer}</dd>
                </div>
                <div class="flex gap-1.5">
                  <dt class="text-term-pink">date:</dt>
                  <dd class="text-term-amber">
                    <time datetime={c.date}>{fmt.format(new Date(`${c.date}T00:00:00Z`))}</time>
                  </dd>
                </div>
                <div class="mt-2">
                  <dt class="sr-only">url</dt>
                  <dd>
                    <a
                      href={c.credentialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-term-cyan hover:text-term-green underline-offset-4 hover:underline"
                    >
                      <Icon name="external" class="w-3.5 h-3.5" />
                      {t.certifications.credential}
                      <span class="sr-only">: {c.title}</span>
                    </a>
                  </dd>
                </div>
              </dl>
            </Window>
          </li>
        ))
      }
    </ul>
  </div>
</section>
