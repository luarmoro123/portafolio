---
import { agents, type AgentKey } from '../data/agents';

interface Props {
  index: string;
  file: string;
  title: string;
  subtitle?: string;
  agent: AgentKey;
  builtBy: string;
}

const { index, file, title, subtitle, agent, builtBy } = Astro.props;
const a = agents[agent];
---

<header class="mb-10 sm:mb-12" data-reveal>
  <p class="text-xs sm:text-sm text-muted mb-2">
    <span class="text-term-amber">{index}</span> · ~/{file}
    <span class="ml-2">// {builtBy} <span style={`color:${a.color}`}>{a.name}</span></span>
  </p>
  <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
    <span class="text-term-green me-2" aria-hidden="true">&gt;</span>
    {title}
  </h2>
  {subtitle && <p class="mt-3 font-sans text-muted text-base sm:text-lg max-w-2xl">/* {subtitle} */</p>}
</header>
