---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { languages, useTranslations, type Lang } from '../i18n';
import { profile } from '../data/profile';
import profileImg from '../assets/profile.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(languages[lang].path, site).href;
const ogImage = await getImage({ src: profileImg, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  jobTitle: t.hero.title,
  worksFor: { '@type': 'Organization', name: 'Grupo STI' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Politécnica de Sinaloa' },
  url: canonical,
  image: ogImageUrl,
  email: `mailto:${profile.email}`,
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['Quality Assurance', 'Playwright', 'Postman', 'Test Automation', 'React', 'Next.js', 'Astro', 'Kotlin'],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={profile.fullName} />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(languages).map(([code, l]) => (
        <link rel="alternate" hreflang={code} href={new URL(l.path, site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={languages[lang].locale.replace('-', '_')} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0f0c" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        // Intro de agentes en cada visita, salvo si el usuario pidió reducir el movimiento.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          r.classList.add('intro');
          setTimeout(function () { r.classList.remove('intro'); }, 15000); // seguro por si algo falla
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-term-green focus:text-ink focus:rounded-lg focus:font-semibold"
    >
      {t.nav.skip}
    </a>
    <slot />
    <script>
      // Aparición suave de secciones al hacer scroll
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
